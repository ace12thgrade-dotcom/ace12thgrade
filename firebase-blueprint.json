{
  "entities": {
    "curriculum": {
      "title": "Curriculum",
      "description": "Global custom curriculum configuration, including custom subjects, deleted chapters, and custom modules",
      "type": "object",
      "properties": {
        "customSubjects": { "type": "array", "description": "Custom added subjects" },
        "deletedSubjects": { "type": "array", "description": "Deleted subject IDs" },
        "deletedChapters": { "type": "array", "description": "Deleted chapter IDs" },
        "customChapters": { "type": "object", "description": "Subject to custom chapters mapping" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update" }
      }
    },
    "notes": {
      "title": "Notes",
      "description": "Custom rewritten notes per chapter",
      "type": "object",
      "properties": {
        "subjectId": { "type": "string", "description": "Subject identifier" },
        "chapterId": { "type": "string", "description": "Chapter identifier" },
        "markdown": { "type": "string", "description": "Custom Markdown content" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update" }
      },
      "required": ["subjectId", "chapterId", "markdown"]
    },
    "pyqs": {
      "title": "PYQs",
      "description": "Custom solved PYQs per chapter",
      "type": "object",
      "properties": {
        "subjectId": { "type": "string", "description": "Subject identifier" },
        "chapterId": { "type": "string", "description": "Chapter identifier" },
        "markdown": { "type": "string", "description": "Custom Markdown solved PYQs" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update" }
      },
      "required": ["subjectId", "chapterId", "markdown"]
    },
    "books": {
      "title": "Books",
      "description": "Uploaded PDF textbooks and question banks",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique book identifier" },
        "title": { "type": "string", "description": "Book title" },
        "subjectId": { "type": "string", "description": "Subject identifier" },
        "chapterId": { "type": "string", "description": "Chapter identifier or empty" },
        "author": { "type": "string", "description": "Book author" },
        "description": { "type": "string", "description": "Book description" },
        "fileType": { "type": "string", "description": "File format type e.g. pdf" },
        "fileSize": { "type": "number", "description": "Size in bytes" },
        "uploadDate": { "type": "string", "description": "ISO upload date" },
        "dataUrl": { "type": "string", "description": "Base64 data or PDF URL" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update" }
      },
      "required": ["id", "title", "subjectId", "dataUrl"]
    },
    "settings": {
      "title": "Settings",
      "description": "Admin configuration and passcode hash",
      "type": "object",
      "properties": {
        "adminPasscode": { "type": "string", "description": "Admin security passcode" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update" }
      }
    }
  },
  "firestoreRules": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    // Curriculum, notes, pyqs, and books are publicly readable by students across all devices\n    match /{document=**} {\n      allow read, write: if true;\n    }\n  }\n}"
}
